// Project manifest
manifest {
    name = 'test-workflow'
    description = 'Simple test workflow that runs multiple parallel jobs'
    version = '1.0.0'
    mainScript = 'hello.nf'
}

// Parameters with defaults
 params {
      greeting = "Testing"
      name = "GitHub"       // Duration per job in seconds
      count = 2
  }

// Basic configuration
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    container = 'ubuntu:22.04'
}

// Enable container execution
docker {
    enabled = true
}

singularity {
    enabled = false
}

// GCP Batch specific configuration
google {
    batch {
        spot = true
    }
}
